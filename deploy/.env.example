# Copy this file to deploy/.env and replace every required placeholder.
# Keep deploy/.env out of git; it contains bearer tokens and passwords.
ALICEDEV_HOST=alicedev.237575.xyz
TELEGRAM_BOT_TOKEN=replace-with-telegram-botfather-token
PASEO_PASSWORD=replace-with-a-long-random-paseo-password
ALICEDEV_INTERNAL_TOKEN=replace-with-a-long-random-internal-token
GATEWAY_SECRET=replace-with-a-long-random-gateway-secret
ASTRBOT_DASHBOARD_INITIAL_PASSWORD=replace-with-a-long-random-dashboard-password

# Host interface the admin panels (SnowLuma WebUI 5099 + noVNC login 6081,
# AstrBot dashboard 6185) publish on. Set to the host's netbird IP (e.g.
# 100.85.238.88) to reach them over the mesh with no SSH tunnel; leave unset to
# keep them loopback-only. The noVNC desktop and WebUI must never face the public net.
PANEL_BIND_IP=

# Shared bearer token for AstrBot's aiocqhttp reverse WebSocket and the SnowLuma
# wsClient. Generate once in a controlled terminal; store the value only in deploy/.env.
# AstrBot and SnowLuma only get it when their config is first seeded; rotating it
# later means editing both configs (ARCHITECTURE §11, .omp/rules/deploy.md §6).
ONEBOT_ACCESS_TOKEN=

# Optional SnowLuma remote-desktop (noVNC) password. Leave empty to have a random
# one generated and printed once in the container logs on first start.
VNC_PASSWD=

# GitHub token (RiriAgent). Required: paseo agents use it for git/gh (issue → PR,
# fixed-main fetch, deploy fetch) through the image's credential helper; the bot
# uses it for issue/PR prefetch. Source of truth: SOPS alicedev_deploy_env_b64.
GITHUB_TOKEN=

# AstrBot dashboard API key with scope `plugin`, used by deployrun inside paseo
# to hot-reload the alicedev plugin (POST /api/v1/plugins/alicedev/reload).
# Create once via the dashboard API, then store it in SOPS.
ASTRBOT_API_KEY=

# Initial dashboard password of the resident e2e AstrBot (deploy/e2e); also
# passed to paseo so tools/e2e_driver.py can log into its WebChat.
E2E_DASHBOARD_PASSWORD=

# API key for the opencode-go omp provider used inside the paseo container.
OPENCODE_API_KEY=

# Host checkouts. Use absolute paths: this file is shared by deploy/ and the
# e2e compose file, which live in different directories.
#   ALICEDEV_APP_DIR   deployctl-owned alicedev checkout mounted by astrbot/paseo
#   E2E_SRC_DIR        checkout mounted by the resident e2e stack
#   PASEO_SRC_CONTEXT  unmodified mouriya-s-lab/paseo source at PASEO_SRC_REF
ALICEDEV_APP_DIR=/srv/alicedev/app
E2E_SRC_DIR=/srv/alicedev/e2e-src
PASEO_SRC_CONTEXT=/srv/alicedev/src/paseo
PASEO_SRC_REF=7ab7c444d
PASEO_VERSION=0.8.0
OMP_VERSION=18.2.5

# gid of the host `docker` group (owner of /var/run/docker.sock).
DOCKER_GID=989
