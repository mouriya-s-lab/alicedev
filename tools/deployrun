#!/usr/bin/env sh
# deployrun = deployctl run: apply one commit to the host checkout, verify the
# running revision, and roll back to the previous HEAD on failure.
# Outcome JSON on stdout: active | rolled_back | deploy_failed (exit 0 only for active).
# Runs inside the paseo container (checkout mounted at /deploy/app), e.g.:
#   /deploy/app/tools/deployrun --app /deploy/app --commit <sha>
exec "$(dirname -- "$0")/deployctl" run "$@"
