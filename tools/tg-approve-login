#!/usr/bin/env python3
"""Approve a Telegram QR login from an already-authorized local tg-cli session.

    ~/.local/share/uv/tools/kabi-tg-cli/bin/python tools/tg-approve-login 'tg://login?token=...'

Pairs with deploy/tg-cli/qr-login.py running in alicedev-tg-cli: that side
prints the ``tg://login?token=`` URL, this side accepts it with the operator's
local session (same Telethon API id/hash and session path kabi-tg-cli uses).
The server then holds its own independent authorization; the local session
file is never copied.
"""

from __future__ import annotations

import asyncio
import base64
import sys
from urllib.parse import parse_qs, urlparse

from telethon import TelegramClient
from telethon.tl.functions.auth import AcceptLoginTokenRequest

from tg_cli.config import get_api_hash, get_api_id, get_session_path


def token_bytes(url: str) -> bytes:
    query = parse_qs(urlparse(url).query)
    raw = (query.get("token") or [""])[0]
    if not raw:
        raise SystemExit("no token in URL")
    return base64.urlsafe_b64decode(raw + "=" * (-len(raw) % 4))


async def main(url: str) -> int:
    client = TelegramClient(get_session_path(), get_api_id(), get_api_hash())
    await client.connect()
    try:
        if not await client.is_user_authorized():
            print("local tg-cli session is not authorized", file=sys.stderr)
            return 2
        authorization = await client(AcceptLoginTokenRequest(token=token_bytes(url)))
        print(f"APPROVED device={getattr(authorization, 'device_model', '?')} "
              f"app={getattr(authorization, 'app_name', '?')}")
        return 0
    finally:
        await client.disconnect()


if __name__ == "__main__":
    if len(sys.argv) != 2:
        raise SystemExit("usage: tg-approve-login 'tg://login?token=...'")
    raise SystemExit(asyncio.run(main(sys.argv[1])))
