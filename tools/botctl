#!/usr/bin/env python3
"""CLI shim for the alicedev bot internal upgrade API.

The bot API is intentionally private: callers provide the internal API base URL
through the same variables injected into paseo (ALICEDEV_INTERNAL_API and
ALICEDEV_INTERNAL_TOKEN).  This command never talks to the public gateway.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path
from urllib.error import HTTPError, URLError
from urllib.parse import urlencode
from urllib.request import Request, urlopen

_DEFAULT_API = "http://127.0.0.1:6200"
_TIMEOUT_SECONDS = 10.0


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="botctl")
    commands = parser.add_subparsers(dest="command", required=True)

    callback = commands.add_parser("callback", help="deliver one upgrade boundary event")
    callback.add_argument("event", type=Path, metavar="<event.json>")

    state = commands.add_parser("state", help="read upgrade runs for one chat")
    state.add_argument("--chat", required=True, metavar="<chat-key>")
    return parser


def _base_url() -> str:
    value = os.environ.get("ALICEDEV_INTERNAL_API", _DEFAULT_API).strip()
    if not value:
        raise ValueError("ALICEDEV_INTERNAL_API is empty")
    return value.rstrip("/")


def _token() -> str:
    token = os.environ.get("ALICEDEV_INTERNAL_TOKEN", "")
    if not token:
        raise ValueError("ALICEDEV_INTERNAL_TOKEN is not set")
    return token


def _request(method: str, path: str, *, body: bytes | None = None) -> bytes:
    headers = {"X-Alicedev-Token": _token()}
    if body is not None:
        headers["Content-Type"] = "application/json"
    request = Request(_base_url() + path, data=body, headers=headers, method=method)
    with urlopen(request, timeout=_TIMEOUT_SECONDS) as response:
        return response.read()


def _print_response(payload: bytes) -> None:
    # Preserve the bot's machine-readable response.  Do not wrap or reformat it:
    # conductor callers may depend on the exact JSON fields returned by the API.
    sys.stdout.buffer.write(payload)
    if payload and not payload.endswith(b"\n"):
        sys.stdout.buffer.write(b"\n")


def _run(args: argparse.Namespace) -> int:
    if args.command == "callback":
        raw = args.event.read_bytes()
        try:
            parsed = json.loads(raw)
        except (UnicodeDecodeError, json.JSONDecodeError) as exc:
            raise ValueError(f"invalid event JSON: {exc}") from exc
        if not isinstance(parsed, dict):
            raise ValueError("event JSON must be an object")
        _print_response(_request("POST", "/v1/upgrade/callback", body=raw))
        return 0

    if args.command == "state":
        chat = args.chat.strip()
        if not chat:
            raise ValueError("--chat must not be empty")
        path = "/v1/upgrade/state?" + urlencode({"chat": chat})
        _print_response(_request("GET", path))
        return 0

    raise ValueError(f"unsupported command: {args.command}")


def main(argv: list[str] | None = None) -> int:
    args = _parser().parse_args(argv)
    try:
        return _run(args)
    except HTTPError as exc:
        detail = exc.read().decode("utf-8", errors="replace").strip()
        suffix = f": {detail}" if detail else ""
        print(f"botctl: HTTP {exc.code}{suffix}", file=sys.stderr)
        return 1
    except (OSError, URLError, ValueError) as exc:
        print(f"botctl: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
